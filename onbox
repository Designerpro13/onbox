#!/bin/bash
#
# onbox — Minimal secure Google Drive CLI wrapper
# Usage: onbox push <file> | onbox mount | onbox umount | onbox ls
#

set -o pipefail

# Configuration
readonly REMOTE="drive:"
readonly MOUNTPOINT="$HOME/Drive"
readonly SERVICE="onbox-mount.service"
readonly TIMEOUT=300  # 5 minutes inactivity

# Colors (optional, for cleaner output)
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

# ============================================================================
# Helper Functions
# ============================================================================

log_info() {
    echo -e "${GREEN}→${NC} $1"
}

log_error() {
    echo -e "${RED}✗${NC} $1" >&2
}

log_warn() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Check if drive is mounted
is_mounted() {
    mountpoint -q "$MOUNTPOINT"
}

# Start the mount service
start_mount() {
    mkdir -p "$MOUNTPOINT" || {
        log_error "Failed to create mount directory: $MOUNTPOINT"
        return 1
    }

    log_info "Starting Google Drive mount..."
    systemctl --user start "$SERVICE" || {
        log_error "Failed to start systemd service"
        return 1
    }

    # Wait for mount to stabilize (rclone needs a moment)
    sleep 2

    if is_mounted; then
        log_info "Google Drive mounted at $MOUNTPOINT"
        return 0
    else
        log_error "Mount started but drive not accessible"
        return 1
    fi
}

# Stop the mount service
stop_mount() {
    if ! is_mounted; then
        log_warn "Drive not currently mounted"
        return 0
    fi

    log_info "Unmounting Google Drive..."
    systemctl --user stop "$SERVICE" || {
        log_error "Failed to stop service. Try: sudo fusermount -u $MOUNTPOINT"
        return 1
    }

    sleep 1
    log_info "Unmounted"
    return 0
}

# Schedule auto-unmount after inactivity timeout
auto_timeout() {
    (
        sleep "$TIMEOUT"

        # Check if any files are open in the mount
        if ! lsof +D "$MOUNTPOINT" >/dev/null 2>&1; then
            # No open files, safe to unmount
            systemctl --user stop "$SERVICE" 2>/dev/null
        fi
    ) &
}

# ============================================================================
# Commands
# ============================================================================

cmd_push() {
    local file="$1"

    if [ -z "$file" ]; then
        log_error "Usage: onbox push <file>"
        return 1
    fi

    if [ ! -e "$file" ]; then
        log_error "File not found: $file"
        return 1
    fi

    # Check if mounted, mount if needed
    if ! is_mounted; then
        start_mount || return 1
    fi

    # Upload the file
    log_info "Uploading $(basename "$file") to Google Drive..."
    if rclone copy "$file" "$REMOTE" --progress; then
        log_info "Upload complete"
        # Schedule unmount after inactivity
        auto_timeout
        return 0
    else
        log_error "Upload failed"
        return 1
    fi
}

cmd_mount() {
    if is_mounted; then
        log_warn "Drive already mounted at $MOUNTPOINT"
        return 0
    fi
    start_mount
}

cmd_umount() {
    stop_mount
}

cmd_ls() {
    log_info "Listing files on Google Drive..."
    rclone ls "$REMOTE"
}

cmd_help() {
    cat <<EOF
onbox — Minimal secure Google Drive CLI

USAGE:
  onbox push <file>     Upload file to Google Drive
  onbox mount          Manually mount Google Drive
  onbox umount         Manually unmount Google Drive
  onbox ls             List files on Google Drive
  onbox help           Show this help

EXAMPLES:
  onbox push document.pdf
  onbox push ~/Downloads/photo.jpg
  onbox ls

For more info: https://github.com/<you>/onbox
EOF
}

# ============================================================================
# Main
# ============================================================================

main() {
    local command="${1:-help}"

    case "$command" in
        push)
            cmd_push "$2"
            ;;
        mount)
            cmd_mount
            ;;
        umount)
            cmd_umount
            ;;
        ls)
            cmd_ls
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            log_error "Unknown command: $command"
            cmd_help
            return 1
            ;;
    esac
}

main "$@"
