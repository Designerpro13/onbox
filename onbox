#!/usr/bin/env bash
#
# onbox — minimal Google Drive CLI wrapper
# Usage: onbox push <file> | onbox mount | onbox umount | onbox ls
#

set -o errexit
set -o nounset
set -o pipefail

readonly REMOTE="drive:"
readonly MOUNTPOINT="$HOME/Drive"
readonly SERVICE="onbox-mount.service"
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

log_info() {
    printf '%b\n' "${GREEN}→${NC} $*"
}

log_error() {
    printf '%b\n' "${RED}✗${NC} $*" >&2
}

log_warn() {
    printf '%b\n' "${YELLOW}⚠${NC} $*"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        log_error "Required command not found: $1"
        return 1
    }
}

is_mounted() {
    mountpoint -q -- "$MOUNTPOINT"
}

start_mount() {
    require_command systemctl
    require_command mountpoint

    mkdir -p -- "$MOUNTPOINT" || {
        log_error "Failed to create mount directory: $MOUNTPOINT"
        return 1
    }

    log_info "Starting Google Drive mount..."
    if ! systemctl --user start "$SERVICE"; then
        log_error "Failed to start $SERVICE"
        log_error "Inspect logs with: journalctl --user -u $SERVICE -n 50"
        return 1
    fi

    local attempt
    for ((attempt = 0; attempt < 30; attempt++)); do
        if is_mounted; then
            log_info "Google Drive mounted at $MOUNTPOINT"
            return 0
        fi
        sleep 0.5
    done

    log_error "The service started, but $MOUNTPOINT did not become a mount point"
    log_error "Inspect logs with: journalctl --user -u $SERVICE -n 50"
    return 1
}

stop_mount() {
    require_command systemctl

    if ! systemctl --user is-active --quiet "$SERVICE"; then
        log_warn "Mount service is not active"
        return 0
    fi

    log_info "Unmounting Google Drive..."
    if ! systemctl --user stop "$SERVICE"; then
        log_error "Failed to stop $SERVICE"
        return 1
    fi

    log_info "Unmounted"
}

cmd_push() {
    if (( $# != 1 )); then
        log_error "Usage: onbox push <file>"
        return 2
    fi

    local file="$1"
    if [[ ! -f "$file" ]]; then
        log_error "Not a regular file: $file"
        return 1
    fi
    if [[ ! -r "$file" ]]; then
        log_error "File is not readable: $file"
        return 1
    fi

    require_command rclone
    require_command realpath

    # An absolute local path cannot be mistaken for an rclone flag or remote.
    file="$(realpath -- "$file")"
    log_info "Uploading $(basename -- "$file") to $REMOTE"
    if rclone copy "$file" "$REMOTE" --progress; then
        log_info "Upload complete"
    else
        log_error "Upload failed"
        return 1
    fi
}

cmd_mount() {
    require_command mountpoint
    if is_mounted; then
        log_warn "Drive is already mounted at $MOUNTPOINT"
        return 0
    fi
    start_mount
}

cmd_umount() {
    stop_mount
}

cmd_ls() {
    require_command rclone
    log_info "Listing files on $REMOTE"
    rclone ls "$REMOTE"
}

cmd_help() {
    cat <<'EOF'
onbox — minimal Google Drive CLI

USAGE:
  onbox push <file>     Upload one file directly with rclone
  onbox mount           Mount drive: at ~/Drive using a systemd user service
  onbox umount          Stop the mount service
  onbox ls              List files visible through drive:
  onbox help            Show this help

Closing the terminal interrupts push. The optional mount service is independent
of the terminal until it is stopped with `onbox umount`.
EOF
}

main() {
    local command="${1:-help}"
    if (( $# > 0 )); then
        shift
    fi

    case "$command" in
        push) cmd_push "$@" ;;
        mount)
            (( $# == 0 )) || { log_error "Usage: onbox mount"; return 2; }
            cmd_mount
            ;;
        umount)
            (( $# == 0 )) || { log_error "Usage: onbox umount"; return 2; }
            cmd_umount
            ;;
        ls)
            (( $# == 0 )) || { log_error "Usage: onbox ls"; return 2; }
            cmd_ls
            ;;
        help|--help|-h)
            (( $# == 0 )) || { log_error "Usage: onbox help"; return 2; }
            cmd_help
            ;;
        *)
            log_error "Unknown command: $command"
            cmd_help
            return 2
            ;;
    esac
}

main "$@"
