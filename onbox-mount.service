[Unit]
Description=Onbox Google Drive mount
Documentation=https://github.com/Designerpro13/onbox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
ExecStartPre=/usr/bin/mkdir -p %h/Drive
ExecStart=/usr/bin/env rclone mount drive: %h/Drive \
  --vfs-cache-mode writes \
  --dir-cache-time 12h \
  --poll-interval 30s
KillSignal=SIGINT
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
StandardError=journal
StandardOutput=journal

[Install]
WantedBy=default.target
